# Sandbox Supabase project (vzfsndsqveacpefoqwsu)
# The real anon key is injected by the GitHub Action; this placeholder is
# overridden at build time.
VITE_SUPABASE_URL=https://vzfsndsqveacpefoqwsu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=SANDBOX_ANON_KEY_PLACEHOLDER

# GitHub Pages project-site base path.
# Use /bbqs-website-sandbox/ for https://brain-bbqs.github.io/bbqs-website-sandbox
# Use / if you configure a custom domain like https://sandbox.brain-bbqs.org
VITE_BASE_PATH=/bbqs-website-sandbox/

# Auth cookie domain.
# Leave empty for path-only cookies (recommended for GitHub Pages project sites).
# Set to .sandbox.brain-bbqs.org if you use a custom subdomain.
VITE_AUTH_COOKIE_DOMAIN=
