# Deliberately-inconsistent graph. Every consistency shape should fire on exactly one node here.
# This is the RED half of the RED/GREEN pair that proves the shapes actually bite.
@prefix bbqs: <https://brain-bbqs.org/schema#> .
@prefix bid:  <https://brain-bbqs.org/id/> .

# #4 — non-canonical project_role token
bid:role-1 a bbqs:ProjectRole ;
  bbqs:project_role "Principal Investigator" ;
  bbqs:held_by bid:inv-1 ;
  bbqs:on_project bid:proj-1 .

# #5 — a per-project role token stuffed into the free-text consortium_role
bid:inv-1 a bbqs:Investigator ;
  bbqs:name "Jane Roe" ;
  bbqs:consortium_role "Contact PI" .

# #9 — mechanism disagrees with the grant number (award is U01, mechanism says R61)
bid:proj-1 a bbqs:Project ;
  bbqs:name "Test project" ;
  bbqs:grant_number "1U01MH135430-01" ;
  bbqs:mechanism "R61" .

# #12 — two verified provenance records disagree on projects.title for proj-1
bid:sc-reporter a bbqs:SourceClass ; bbqs:is_verified true .
bid:sc-curator  a bbqs:SourceClass ; bbqs:is_verified true .
bid:prov-a a bbqs:ProvenanceRecord ;
  bbqs:prov_entity_table "projects" ; bbqs:prov_entity_column "title" ; bbqs:prov_entity_id "proj-1" ;
  bbqs:prov_value_text "Title A" ; bbqs:prov_source_class bid:sc-reporter .
bid:prov-b a bbqs:ProvenanceRecord ;
  bbqs:prov_entity_table "projects" ; bbqs:prov_entity_column "title" ; bbqs:prov_entity_id "proj-1" ;
  bbqs:prov_value_text "Title B" ; bbqs:prov_source_class bid:sc-curator .

# held_by — a role whose holder IRI has no Investigator node (the investigator_id-vs-resource_id
# identity bug). bid:ghost-investigator is never typed bbqs:Investigator, so held_by dangles.
bid:role-dangling a bbqs:ProjectRole ;
  bbqs:project_role "co_pi" ;
  bbqs:held_by bid:ghost-investigator .

# #14 — two Investigator nodes share one ORCID (merge candidate)
bid:inv-dup-a a bbqs:Investigator ;
  bbqs:name "Alex Kim" ;
  bbqs:orcid <https://orcid.org/0000-0002-1111-2222> .
bid:inv-dup-b a bbqs:Investigator ;
  bbqs:name "A. Kim" ;
  bbqs:orcid <https://orcid.org/0000-0002-1111-2222> .

# #15 — one email split across two "different" people (the lyc5332@psu.edu class of bug)
bid:inv-email-a a bbqs:Investigator ;
  bbqs:name "Lin Chen" ;
  bbqs:email "lyc5332@psu.edu" .
bid:inv-email-b a bbqs:Investigator ;
  bbqs:name "L. Chen (duplicate record)" ;
  bbqs:secondary_emails "lyc5332@psu.edu" .

# #16 — a second edge for the SAME held_by+on_project pair with a DIFFERENT role
bid:role-16 a bbqs:ProjectRole ;
  bbqs:project_role "co_pi" ;
  bbqs:held_by bid:inv-1 ;
  bbqs:on_project bid:proj-1 .

# #17 — a publication's author_orcids has no matching Investigator node
bid:pub-1 a bbqs:Publication ;
  bbqs:title "A BBQS paper" ;
  bbqs:author_orcids <https://orcid.org/0000-0002-9999-0000> .

# #18 — a grade-3 (harvested) record disagrees with a grade-1 (curator) record
bid:sc-grade1 a bbqs:SourceClass ; bbqs:grade 1 ; bbqs:is_verified true .
bid:sc-grade3 a bbqs:SourceClass ; bbqs:grade 3 ; bbqs:is_verified false .
bid:prov-c a bbqs:ProvenanceRecord ;
  bbqs:prov_entity_table "investigators" ; bbqs:prov_entity_column "institution" ; bbqs:prov_entity_id "inv-9" ;
  bbqs:prov_value_text "MIT" ; bbqs:prov_source_class bid:sc-grade1 .
bid:prov-d a bbqs:ProvenanceRecord ;
  bbqs:prov_entity_table "investigators" ; bbqs:prov_entity_column "institution" ; bbqs:prov_entity_id "inv-9" ;
  bbqs:prov_value_text "MIT (Broad Institute)" ; bbqs:prov_source_class bid:sc-grade3 .

# #19 — a Project node with zero provenance claims
bid:proj-no-prov a bbqs:Project ;
  bbqs:name "Orphan project" ;
  bbqs:grant_number "1U01MH000000-01" .
