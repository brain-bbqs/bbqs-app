# The same graph as contradictions.ttl, corrected. Every consistency shape should pass (conforms).
# This is the GREEN half of the pair.
@prefix bbqs: <https://brain-bbqs.org/schema#> .
@prefix bid:  <https://brain-bbqs.org/id/> .

# #4 — canonical token
bid:role-1 a bbqs:ProjectRole ;
  bbqs:project_role "contact_pi" ;
  bbqs:held_by bid:inv-1 ;
  bbqs:on_project bid:proj-1 .

# #5 — consortium_role is a career label, not a role token
bid:inv-1 a bbqs:Investigator ;
  bbqs:name "Jane Roe" ;
  bbqs:consortium_role "Associate Professor" .

# #9 — mechanism matches the grant number
bid:proj-1 a bbqs:Project ;
  bbqs:name "Test project" ;
  bbqs:grant_number "1U01MH135430-01" ;
  bbqs:mechanism "U01" .

# #12 — the two verified sources agree on projects.title
bid:sc-reporter a bbqs:SourceClass ; bbqs:is_verified true .
bid:sc-curator  a bbqs:SourceClass ; bbqs:is_verified true .
bid:prov-a a bbqs:ProvenanceRecord ;
  bbqs:prov_entity_table "projects" ; bbqs:prov_entity_column "title" ; bbqs:prov_entity_id "proj-1" ;
  bbqs:prov_value_text "Title A" ; bbqs:prov_source_class bid:sc-reporter .
bid:prov-b a bbqs:ProvenanceRecord ;
  bbqs:prov_entity_table "projects" ; bbqs:prov_entity_column "title" ; bbqs:prov_entity_id "proj-1" ;
  bbqs:prov_value_text "Title A" ; bbqs:prov_source_class bid:sc-curator .

# #14 — distinct ORCIDs, distinct people
bid:inv-dup-a a bbqs:Investigator ;
  bbqs:name "Alex Kim" ;
  bbqs:orcid <https://orcid.org/0000-0002-1111-2222> .
bid:inv-dup-b a bbqs:Investigator ;
  bbqs:name "Sam Lee" ;
  bbqs:orcid <https://orcid.org/0000-0002-3333-4444> .

# #15 — no email shared across two nodes
bid:inv-email-a a bbqs:Investigator ;
  bbqs:name "Lin Chen" ;
  bbqs:email "lyc5332@psu.edu" .
bid:inv-email-b a bbqs:Investigator ;
  bbqs:name "Sam Lee" ;
  bbqs:secondary_emails "sam.lee@example.edu" .

# #16 — only one ProjectRole edge for inv-1 + proj-1, so there's nothing to disagree with

# #17 — the author ORCID resolves to a real Investigator node
bid:pub-1 a bbqs:Publication ;
  bbqs:title "A BBQS paper" ;
  bbqs:author_orcids <https://orcid.org/0000-0002-9999-0000> .
bid:inv-author a bbqs:Investigator ;
  bbqs:name "Pat Author" ;
  bbqs:orcid <https://orcid.org/0000-0002-9999-0000> .

# #18 — the grade-1 and grade-3 records agree
bid:sc-grade1 a bbqs:SourceClass ; bbqs:grade 1 ; bbqs:is_verified true .
bid:sc-grade3 a bbqs:SourceClass ; bbqs:grade 3 ; bbqs:is_verified false .
bid:prov-c a bbqs:ProvenanceRecord ;
  bbqs:prov_entity_table "investigators" ; bbqs:prov_entity_column "institution" ; bbqs:prov_entity_id "inv-9" ;
  bbqs:prov_value_text "MIT" ; bbqs:prov_source_class bid:sc-grade1 .
bid:prov-d a bbqs:ProvenanceRecord ;
  bbqs:prov_entity_table "investigators" ; bbqs:prov_entity_column "institution" ; bbqs:prov_entity_id "inv-9" ;
  bbqs:prov_value_text "MIT" ; bbqs:prov_source_class bid:sc-grade3 .

# #19 — the project has a provenance claim
bid:proj-no-prov a bbqs:Project ;
  bbqs:name "Orphan project" ;
  bbqs:grant_number "1U01MH000000-01" .
bid:sc-basic a bbqs:SourceClass ; bbqs:grade 2 ; bbqs:is_verified false .
bid:prov-e a bbqs:ProvenanceRecord ;
  bbqs:prov_entity_table "projects" ; bbqs:prov_entity_column "name" ; bbqs:prov_entity_id "proj-no-prov" ;
  bbqs:prov_value_text "Orphan project" ; bbqs:prov_source_class bid:sc-basic .
