# The same graph as contradictions.ttl, corrected. Every validation shape passes (conforms), and
# kg/quality.py duplicates() finds no possible duplicate and no pair left to link: its same-title
# preprint and published paper are linked by revision_of. This is the GREEN half of the pair.
@prefix bbqs: <https://brain-bbqs.org/schema#> .
@prefix bid:  <https://brain-bbqs.org/id/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# #4 — canonical token
bid:role-1 a bbqs:ProjectRole ;
  bbqs:project_role "contact_pi" ;
  bbqs:held_by bid:inv-1 ;
  bbqs:on_project bid:proj-1 .

# #5 — a PI label, backed by a PI role on the roster (role-1)
bid:inv-1 a bbqs:Investigator ;
  bbqs:name "Jane Roe" ;
  bbqs:consortium_role "Principal Investigator (PI)" .

# #9 — mechanism matches the grant number
# #7 — the study_species claim resolved (here through a Species alias), so only the link is written
bid:proj-1 a bbqs:Project ;
  bbqs:name "Test project" ;
  bbqs:grant_number "1U01MH135430-01" ;
  bbqs:mechanism "U01" ;
  bbqs:studies_species bid:sp-mouse .
bid:sp-mouse a bbqs:Species ;
  bbqs:name "House Mouse" ;
  bbqs:common_name "House Mouse" ;
  bbqs:aliases "Mus musculus" .

# #12 — the two verified sources agree on projects.title
bid:sc-reporter a bbqs:SourceClass ; bbqs:is_verified true .
bid:sc-curator  a bbqs:SourceClass ; bbqs:is_verified true .
bid:prov-a a bbqs:ProvenanceRecord ;
  bbqs:prov_entity_table "projects" ; bbqs:prov_entity_column "title" ; bbqs:prov_entity_id "proj-1" ;
  bbqs:prov_value_text "Title A" ; bbqs:prov_source_class bid:sc-reporter .
bid:prov-b a bbqs:ProvenanceRecord ;
  bbqs:prov_entity_table "projects" ; bbqs:prov_entity_column "title" ; bbqs:prov_entity_id "proj-1" ;
  bbqs:prov_value_text "Title A" ; bbqs:prov_source_class bid:sc-curator .

# #14 — distinct ORCIDs, distinct people
bid:inv-dup-a a bbqs:Investigator ;
  bbqs:name "Alex Kim" ;
  bbqs:orcid <https://orcid.org/0000-0002-1111-2222> .
bid:inv-dup-b a bbqs:Investigator ;
  bbqs:name "Sam Lee" ;
  bbqs:orcid <https://orcid.org/0000-0002-3333-4444> .

# #15 — no email shared across two nodes
bid:inv-email-a a bbqs:Investigator ;
  bbqs:name "Lin Chen" ;
  bbqs:email "lyc5332@psu.edu" .
bid:inv-email-b a bbqs:Investigator ;
  bbqs:name "Robin Park" ;
  bbqs:secondary_emails "robin.park@example.edu" .

# #16 — only one ProjectRole edge for inv-1 + proj-1, so there's nothing to disagree with

# #17 — the author ORCID resolves to a real Investigator node
bid:pub-1 a bbqs:Publication ;
  bbqs:title "A BBQS paper" ;
  bbqs:author_orcids <https://orcid.org/0000-0002-9999-0000> .
bid:inv-author a bbqs:Investigator ;
  bbqs:name "Pat Author" ;
  bbqs:orcid <https://orcid.org/0000-0002-9999-0000> .

# #18 — the grade-1 and grade-3 records agree
bid:sc-grade1 a bbqs:SourceClass ; bbqs:grade 1 ; bbqs:is_verified true .
bid:sc-grade3 a bbqs:SourceClass ; bbqs:grade 3 ; bbqs:is_verified false .
bid:prov-c a bbqs:ProvenanceRecord ;
  bbqs:prov_entity_table "investigators" ; bbqs:prov_entity_column "institution" ; bbqs:prov_entity_id "inv-9" ;
  bbqs:prov_value_text "MIT" ; bbqs:prov_source_class bid:sc-grade1 .
bid:prov-d a bbqs:ProvenanceRecord ;
  bbqs:prov_entity_table "investigators" ; bbqs:prov_entity_column "institution" ; bbqs:prov_entity_id "inv-9" ;
  bbqs:prov_value_text "MIT" ; bbqs:prov_source_class bid:sc-grade3 .

# #19 — the project has a provenance claim
bid:proj-no-prov a bbqs:Project ;
  bbqs:name "Orphan project" ;
  bbqs:grant_number "1U01MH000000-01" .
bid:sc-basic a bbqs:SourceClass ; bbqs:grade 2 ; bbqs:is_verified false .
bid:prov-e a bbqs:ProvenanceRecord ;
  bbqs:prov_entity_table "projects" ; bbqs:prov_entity_column "name" ; bbqs:prov_entity_id "proj-no-prov" ;
  bbqs:prov_value_text "Orphan project" ; bbqs:prov_source_class bid:sc-basic .

# #1/#3 — one node, one class
bid:dual-1 a bbqs:ResearchOrganization ;
  bbqs:name "Dual Entity" .

# #1 — the data standard is filed as what it is, with its (non-BBQS) funding award as an attribute
bid:proj-no-award a bbqs:Standard ;
  bbqs:name "A data standard filed as a grant" ;
  bbqs:award_numbers "RF1MH000001" .

# #20 — every award identifier on the node names the same award
bid:proj-renumbered a bbqs:Project ;
  bbqs:name "U24DA064429" ;
  bbqs:grant_number "U24DA064429" ;
  bbqs:mechanism "U24" .
bid:prov-g a bbqs:ProvenanceRecord ;
  bbqs:prov_entity_table "grants" ; bbqs:prov_entity_column "grant_number" ; bbqs:prov_entity_id "proj-renumbered" ;
  bbqs:prov_value_text "U24DA064429" ; bbqs:prov_source_class bid:sc-basic .

# #10 — one URL per URL field
bid:job-1 a bbqs:Job ;
  bbqs:name "Community engineer" ;
  bbqs:external_url "https://jobs.example.org/one"^^xsd:anyURI .

# #6 — one holder per role edge
bid:role-two a bbqs:ProjectRole ;
  bbqs:project_role "co_pi" ;
  bbqs:held_by bid:inv-dup-a ;
  bbqs:on_project bid:proj-renumbered .

# #21, #22, #25 — a published paper and its preprint: one title, each its own DOI and PMID, two
# records linked by revision_of (published -> preprint), so duplicates() counts them as linked versions
bid:pub-published a bbqs:Publication ;
  bbqs:title "Mapping social behavior across five species" ;
  bbqs:journal "Nat Methods" ;
  bbqs:doi "10.1038/s41592-000-0001-x"^^xsd:anyURI ;
  bbqs:pmid "200001" ;
  bbqs:revision_of bid:pub-preprint .
bid:pub-preprint a bbqs:Publication ;
  bbqs:title "Mapping social behavior across five species" ;
  bbqs:journal "bioRxiv" ;
  bbqs:doi "10.1101/2025.01.01.000001"^^xsd:anyURI ;
  bbqs:pmid "200002" .

# #23 — two funding calls, two FONs and two notice pages
bid:fo-a a bbqs:FundingOpportunity ;
  bbqs:name "A funding call" ;
  bbqs:fon "RFA-XX-27-001" ;
  bbqs:url "https://grants.nih.gov/grants/guide/rfa-files/RFA-XX-27-001.html"^^xsd:anyURI .
bid:fo-b a bbqs:FundingOpportunity ;
  bbqs:name "Another funding call" ;
  bbqs:fon "RFA-XX-27-002" ;
  bbqs:url "https://grants.nih.gov/grants/guide/rfa-files/RFA-XX-27-002.html"^^xsd:anyURI .

# #24 — proj-1, proj-no-prov and proj-renumbered (above) are three awards with three grant numbers
