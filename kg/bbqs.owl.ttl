        cogatlas: ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:DeviceCategory a owl:Class ;
    rdfs:label "DeviceCategory" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:schema_org_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:schema_org_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:category_key ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:measures ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:category_key ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:measures ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:typical_use_cases ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:category_key ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:schema_org_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:typical_use_cases ],
        bbqs:Entity ;
    skos:definition "One of the ~32 canonical BBQS device categories (device_categories: key/label/measures[]/typical_use_cases[]). A SKOS concept scheme; each maps to a schema.org type and (via device_class_crosswalk) to external classes." ;
    skos:exactMatch skos:Concept ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:DeviceManufacturer a owl:Class ;
    rdfs:label "DeviceManufacturer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty bbqs:homepage_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:country ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:country ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:country ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:aliases ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:aliases ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:homepage_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:homepage_url ],
        bbqs:Entity,
        bbqs:Organization ;
    skos:definition "A maker of neural/behavioral/physiological instruments. Sourced from device_manufacturers (NB: needs resource_id backfill to enter the spine)." ;
    skos:exactMatch <http://schema.org/Organization> ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:ExperimentalData a owl:Class ;
    rdfs:label "ExperimentalData" ;
    rdfs:subClassOf bbqs:Entity ;
    skos:definition "RESERVED STUB. The empirical experiment/model data that grounds a MarrModel — explicitly DISTINCT from a released Dataset artifact. Belongs to the Marr layer; wait for the causal-KG." ;
    skos:exactMatch prov:Entity ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:Product a owl:Class ;
    rdfs:label "Product" ;
    rdfs:subClassOf bbqs:Thing ;
    skos:exactMatch <http://schema.org/Product> ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:ResearchOrganization a owl:Class ;
    rdfs:label "ResearchOrganization" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:members ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty bbqs:ror_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:Investigator ;
            owl:onProperty bbqs:members ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:ror_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:ror_id ],
        bbqs:Entity,
        bbqs:Organization ;
    skos:definition "A university, institute, or lab participating in BBQS." ;
    skos:exactMatch <http://schema.org/ResearchOrganization>,
        ror: ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

