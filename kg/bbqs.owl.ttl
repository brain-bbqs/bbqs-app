        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:relevance_tags ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty bbqs:expiration_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:relevance_tags ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:opportunity_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:budget_ceiling ],
        [ a owl:Restriction ;
