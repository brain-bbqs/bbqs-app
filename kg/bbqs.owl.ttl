        <https://brain-bbqs.org/schema#ResourceTypeEnum#device_category>,
        <https://brain-bbqs.org/schema#ResourceTypeEnum#device_manufacturer>,
        <https://brain-bbqs.org/schema#ResourceTypeEnum#event>,
        <https://brain-bbqs.org/schema#ResourceTypeEnum#funding>,
        <https://brain-bbqs.org/schema#ResourceTypeEnum#grant>,
        <https://brain-bbqs.org/schema#ResourceTypeEnum#investigator>,
        <https://brain-bbqs.org/schema#ResourceTypeEnum#job>,
        <https://brain-bbqs.org/schema#ResourceTypeEnum#ml_model>,
        <https://brain-bbqs.org/schema#ResourceTypeEnum#organization>,
        <https://brain-bbqs.org/schema#ResourceTypeEnum#protocol>,
        <https://brain-bbqs.org/schema#ResourceTypeEnum#publication>,
        <https://brain-bbqs.org/schema#ResourceTypeEnum#software>,
        <https://brain-bbqs.org/schema#ResourceTypeEnum#species>,
        <https://brain-bbqs.org/schema#ResourceTypeEnum#tool>,
        <https://brain-bbqs.org/schema#ResourceTypeEnum#working_group> .

