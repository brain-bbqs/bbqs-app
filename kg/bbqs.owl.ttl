        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty bbqs:doi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:journal ],
        [ a owl:Restriction ;
