@prefix NBO: <http://purl.obolibrary.org/obo/NBO_> .
@prefix NCBITaxon: <http://purl.obolibrary.org/obo/NCBITaxon_> .
@prefix OBI: <http://purl.obolibrary.org/obo/OBI_> .
@prefix UBERON: <http://purl.obolibrary.org/obo/UBERON_> .
@prefix bbqs: <https://brain-bbqs.org/schema#> .
@prefix bioschema: <https://bioschemas.org/> .
@prefix cogatlas: <https://www.cognitiveatlas.org/concept/id/> .
@prefix croissant: <http://mlcommons.org/croissant/1.0/> .
@prefix dandi: <https://dandiarchive.org/dandiset/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ror: <https://ror.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://brain-bbqs.org/schema/bbqs.owl.ttl> a owl:Ontology ;
    rdfs:label "bbqs" ;
    dcterms:license "MIT" ;
    dcterms:title "BBQS Knowledge Graph Schema" ;
    pav:version "0.3.0" ;
    skos:definition "LinkML master schema for the BBQS (Brain Behavior Quantification and Synchronization) consortium knowledge graph. Models the consortium as people, artifacts, and ideas connected by projects, grounded in the live Supabase `resources` node spine, aligned to schema.org + PROV-O + NCBITaxon + Bioschemas/Croissant, with reserved hooks for the neuroscience (Marr / causal-KG) layer. OWL is the schema logic; SHACL validates instance exports." .

bbqs:Algorithm a owl:Class ;
    rdfs:label "Algorithm" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom bbqs:Species ;
            owl:onProperty bbqs:studies_species ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:studies_species ],
        bbqs:CreativeWork,
        bbqs:Entity ;
    skos:definition "A computational algorithm, distinct from its software implementation and from a trained model. Promoted to its own resource_type rather than folded into SoftwareTool/MLModel/Protocol, since it's expected to link directly to Species as its own scope grows." ;
    skos:exactMatch <http://schema.org/CreativeWork> ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:Announcement a owl:Class ;
    rdfs:label "Announcement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty bbqs:is_external_link ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:link_text ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:content ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:posted_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:posted_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:link_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:is_external_link ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:content ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:link ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:Investigator ;
            owl:onProperty bbqs:posted_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:is_external_link ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:content ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty bbqs:link ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:link_text ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:link ],
        bbqs:CreativeWork,
        bbqs:Entity ;
    skos:definition "A consortium news post or announcement. `news`, funding blurbs, etc." ;
    skos:exactMatch <http://schema.org/Article> ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:Consortium a owl:Class ;
    rdfs:label "Consortium" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom bbqs:Investigator ;
            owl:onProperty bbqs:members ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:funder ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:members ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:FundingAgency ;
            owl:onProperty bbqs:funder ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:funder ],
        bbqs:Entity,
        bbqs:Organization ;
    skos:definition "The BBQS Consortium itself — a multi-institution NIH-funded collective." ;
    skos:exactMatch <http://schema.org/Organization> ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty bbqs:start_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:end_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:start_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:venue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:attendees ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:venue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:venue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:end_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:start_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty bbqs:end_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:Investigator ;
            owl:onProperty bbqs:attendees ],
        bbqs:Entity,
        bbqs:EventAnchor ;
    skos:definition "A BBQS workshop, convening, or meeting. RESERVED: no data table populates this yet — class exists so the exporter/UI have a home when events land." ;
    skos:exactMatch <http://schema.org/Event> ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

