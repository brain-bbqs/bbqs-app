bbqs:MLModel a owl:Class ;
    rdfs:label "MLModel" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:evaluated_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:Dataset ;
            owl:onProperty bbqs:trained_on ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:repo_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty bbqs:repo_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:repo_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:trained_on ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:Benchmark ;
            owl:onProperty bbqs:evaluated_by ],
        bbqs:CreativeWork,
        bbqs:Entity ;
    skos:definition "A trained/released machine-learning model (resource_type ml_model)." ;
    skos:exactMatch <http://schema.org/SoftwareApplication> ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:Protocol a owl:Class ;
    rdfs:label "Protocol" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom bbqs:Device ;
            owl:onProperty bbqs:uses_device ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:measures_construct ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:uses_device ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:BehavioralConstruct ;
            owl:onProperty bbqs:measures_construct ],
        bbqs:CreativeWork,
        bbqs:Entity ;
    skos:closeMatch OBI:0000272 ;
    skos:definition "An experimental/analysis protocol or method (resource_type protocol)." ;
    skos:exactMatch <http://schema.org/CreativeWork> ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:Publication a owl:Class ;
    rdfs:label "Publication" ;
    rdfs:subClassOf [ a owl:Restriction ;
