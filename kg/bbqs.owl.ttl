            owl:onProperty bbqs:taxonomy_genus ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:aliases ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:taxonomy_genus ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:taxonomy_order ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty bbqs:ncbi_taxon_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:taxonomy_class ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:ncbi_taxon_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:taxonomy_genus ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:common_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:taxonomy_family ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:aliases ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:taxonomy_class ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:common_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:taxonomy_family ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:ncbi_taxon_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:taxonomy_family ],
        bbqs:Entity,
        bbqs:Taxon ;
    skos:definition "A species studied in a BBQS project. Align identifiers to NCBITaxon." ;
    skos:exactMatch NCBITaxon:,
        <http://schema.org/Taxon> ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:aliases a owl:DatatypeProperty ;
    rdfs:label "aliases" ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:funder a owl:ObjectProperty ;
    rdfs:label "funder" ;
    rdfs:range bbqs:FundingAgency ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:label a owl:DatatypeProperty ;
