    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:regulatory_class a owl:DatatypeProperty ;
    rdfs:label "regulatory_class" ;
    skos:definition "Regulatory classification (e.g. an FDA device class), where applicable." ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:reporter_profile_id a owl:DatatypeProperty ;
    rdfs:label "reporter_profile_id" ;
    rdfs:range xsd:integer ;
    skos:definition "NIH RePORTER profile id." ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:reporter_project_num a owl:DatatypeProperty ;
    rdfs:label "reporter_project_num" ;
    skos:definition "Full per-year RePORTER project_num (not the core)." ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:resource_type a owl:ObjectProperty ;
    rdfs:label "resource_type" ;
    rdfs:range bbqs:ResourceTypeEnum ;
    skos:definition "The rdf:type discriminator, from resources.resource_type." ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:role_source a owl:ObjectProperty ;
    rdfs:label "role_source" ;
    rdfs:range bbqs:RoleSourceEnum ;
    skos:definition "Where the role came from -- provenance of the role assignment." ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:ror_id a owl:DatatypeProperty ;
    rdfs:label "ror_id" ;
    rdfs:range xsd:anyURI ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:sampling_rate_hz a owl:DatatypeProperty ;
    rdfs:label "sampling_rate_hz" ;
    rdfs:range xsd:float ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:schema_org_type a owl:DatatypeProperty ;
    rdfs:label "schema_org_type" ;
    skos:definition "device_categories.schema_org_type — the schema.org type this category maps to." ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:scholar_id a owl:DatatypeProperty ;
    rdfs:label "scholar_id" ;
    skos:definition "Google Scholar id." ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:size_bytes a owl:DatatypeProperty ;
    rdfs:label "size_bytes" ;
    rdfs:range xsd:integer ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:software_license a owl:DatatypeProperty ;
    rdfs:label "software_license" ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:source_code a owl:DatatypeProperty ;
    rdfs:label "source_code" ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:start_date a owl:DatatypeProperty ;
    rdfs:label "start_date" ;
    rdfs:range xsd:date ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:status a owl:DatatypeProperty ;
    rdfs:label "status" ;
    skos:definition "Current lifecycle status of the funding opportunity (e.g. open, closed, forecasted)." ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:studies_human a owl:DatatypeProperty ;
    rdfs:label "studies_human" ;
    rdfs:range xsd:boolean ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:taxonomy_class a owl:DatatypeProperty ;
    rdfs:label "taxonomy_class" ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:taxonomy_family a owl:DatatypeProperty ;
    rdfs:label "taxonomy_family" ;
    skos:definition "Linnaean family for the species (e.g. Muridae)." ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:taxonomy_genus a owl:DatatypeProperty ;
    rdfs:label "taxonomy_genus" ;
    skos:definition "Linnaean genus for the species (e.g. Mus)." ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:taxonomy_order a owl:DatatypeProperty ;
    rdfs:label "taxonomy_order" ;
    skos:definition "Linnaean order for the species (e.g. Rodentia)." ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:updated_at a owl:DatatypeProperty ;
    rdfs:label "updated_at" ;
    rdfs:range xsd:dateTime ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:url a owl:DatatypeProperty ;
    rdfs:label "url" ;
    rdfs:range xsd:anyURI ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:venue a owl:DatatypeProperty ;
    rdfs:label "venue" ;
    skos:definition "Physical or virtual venue for the workshop/convening." ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:version a owl:DatatypeProperty ;
    rdfs:label "version" ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:was_attributed_to a owl:ObjectProperty ;
    rdfs:label "was_attributed_to" ;
    rdfs:range bbqs:Agent ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:website a owl:DatatypeProperty ;
    rdfs:label "website" ;
    rdfs:range xsd:anyURI ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:year a owl:DatatypeProperty ;
    rdfs:label "year" ;
    rdfs:range xsd:integer ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:FundingAgency a owl:Class ;
    rdfs:label "FundingAgency" ;
    rdfs:subClassOf bbqs:Entity,
        bbqs:Organization ;
    skos:definition "An organization that funds BBQS research (typically an NIH institute)." ;
    skos:exactMatch <http://schema.org/GovernmentOrganization> ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:MarrModel a owl:Class ;
    rdfs:label "MarrModel" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:implementational_level ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:describes_project ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:computational_level ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:BehavioralConstruct ;
            owl:onProperty bbqs:about_construct ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:Project ;
            owl:onProperty bbqs:describes_project ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:CognitiveTask ;
            owl:onProperty bbqs:about_task ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:about_anatomy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:algorithmic_level ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:AnatomicalSite ;
            owl:onProperty bbqs:about_anatomy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:algorithmic_level ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:describes_project ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:computational_level ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:ExperimentalData ;
            owl:onProperty bbqs:has_experimental_data ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:about_construct ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:implementational_level ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:computational_level ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:algorithmic_level ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:about_task ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:implementational_level ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:has_experimental_data ],
        bbqs:Entity ;
    skos:definition "RESERVED STUB. The BBQS-Marr object: the causal / conceptual-neuroscience graph for a project, spanning Marr's computational, algorithmic, and implementational levels. Developed separately (Nader's causal-KG) and NOT ready — modeled here only as a node Project.has_model can point at, plus the hooks below. Do not flesh out until the causal-KG lands." ;
    skos:exactMatch bbqs:MarrModel ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:ProjectRole a owl:Class ;
    rdfs:label "ProjectRole" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom bbqs:ProjectRoleEnum ;
            owl:onProperty bbqs:project_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:held_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:role_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:project_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:Project ;
            owl:onProperty bbqs:on_project ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:held_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:on_project ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:role_source ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:Investigator ;
            owl:onProperty bbqs:held_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:RoleSourceEnum ;
            owl:onProperty bbqs:role_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:on_project ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:project_role ] ;
    skos:definition "Reified project↔investigator role (grant_investigators). THE authority for \"role on this project\" — canonical tokens only (trg_normalize_grant_role), with role_source provenance. A scalar on Investigator cannot express a role that varies per project (issue #283)." ;
    skos:exactMatch prov:Association ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:held_by a owl:ObjectProperty ;
    rdfs:label "held_by" ;
    rdfs:range bbqs:Investigator ;
    owl:inverseOf bbqs:held_project_roles ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:keywords a owl:DatatypeProperty ;
    rdfs:label "keywords" ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:on_project a owl:ObjectProperty ;
    rdfs:label "on_project" ;
    rdfs:range bbqs:Project ;
    owl:inverseOf bbqs:has_project_role ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:studies_species a owl:ObjectProperty ;
    rdfs:label "studies_species" ;
    rdfs:range bbqs:Species ;
    skos:definition "study_species[] names → Species nodes (resolved)." ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:subClassOf [ owl:unionOf ( bbqs:Organization bbqs:Person ) ],
        bbqs:Thing ;
    skos:definition "A person or organization that can act." ;
    skos:exactMatch prov:Agent ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:BehavioralConstruct a owl:Class ;
    rdfs:label "BehavioralConstruct" ;
    rdfs:subClassOf bbqs:Thing ;
    skos:definition "A behavior or behavioral phenotype under study. RESERVED hook." ;
    skos:exactMatch NBO:,
        skos:Concept ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:Dataset a owl:Class ;
    rdfs:label "Dataset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:license ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:license ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:dataset_species ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:measurement_technique ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:access ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:license ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:Species ;
            owl:onProperty bbqs:dataset_species ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:access ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:Device ;
            owl:onProperty bbqs:measurement_technique ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:access ],
        bbqs:CreativeWork,
        bbqs:Entity ;
    skos:definition "A released dataset. Distinct from a project's Marr-layer ExperimentalData." ;
    skos:exactMatch <http://schema.org/Dataset>,
        bioschema:Dataset ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> ;
    skos:relatedMatch croissant:Dataset .

bbqs:Device a owl:Class ;
    rdfs:label "Device" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:model_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty bbqs:product_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty bbqs:sampling_rate_hz ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:device_category ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty bbqs:sdk_urls ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:price_tier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:sdk_urls ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty bbqs:manual_urls ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:sampling_rate_hz ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:regulatory_class ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:DeviceCategory ;
            owl:onProperty bbqs:device_category ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:aliases ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:manufacturer ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:DeviceManufacturer ;
            owl:onProperty bbqs:manufacturer ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:output_signals ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:aliases ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:product_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:output_signals ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:price_tier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:manufacturer ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:price_tier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:regulatory_class ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:sampling_rate_hz ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:device_category ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:product_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:model_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:manual_urls ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:model_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:regulatory_class ],
        bbqs:Entity,
        bbqs:Product ;
    skos:definition "A physical instrument model used in BBQS data collection (device_models). Its kind is a DeviceCategory (the ~32 canonical categories), NOT a subclass tree. NB: device_models needs resource_id backfill to enter the spine." ;
    skos:exactMatch <http://schema.org/Product> ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:subClassOf bbqs:Agent ;
    skos:exactMatch <http://schema.org/Organization> ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:Project a owl:Class ;
    rdfs:label "Project" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:funder ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:award_amount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:award_amount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty bbqs:studies_human ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:mechanism ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:Dandiset ;
            owl:onProperty bbqs:funded_datasets ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:metadata_completeness ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:onboarding_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:funder ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:onboarding_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty bbqs:website ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:metadata_completeness ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:MarrModel ;
            owl:onProperty bbqs:has_model ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:ProjectRole ;
            owl:onProperty bbqs:has_project_role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:reporter_project_num ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:mechanism ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:Entity ;
            owl:onProperty bbqs:produced ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:fiscal_year ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:fiscal_year ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:abstract ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:keywords ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:has_model ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:FundingAgency ;
            owl:onProperty bbqs:funder ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty bbqs:fiscal_year ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:funded_datasets ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:website ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:studies_species ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty bbqs:award_amount ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:has_project_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:nih_link ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:mechanism ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:keywords ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty bbqs:nih_link ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:studies_species_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:studies_human ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty bbqs:metadata_completeness ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:abstract ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:reporter_project_num ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:grant_number ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:Species ;
            owl:onProperty bbqs:studies_species ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:has_model ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:grant_number ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:studies_species_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:website ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:onboarding_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:abstract ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:nih_link ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:reporter_project_num ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:produced ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:grant_number ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:studies_human ],
        bbqs:Entity,
        bbqs:ProjectAnchor ;
    skos:definition "A BBQS project — the funded scientific work and its NIH award as one node, keyed by grant_number. The Marr/causal model plugs in via has_model." ;
    skos:exactMatch <http://schema.org/ResearchProject> ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> ;
    skos:relatedMatch <http://schema.org/MonetaryGrant> .

bbqs:RoleSourceEnum a owl:Class ;
    rdfs:label "role_source_enum" ;
    owl:unionOf ( <https://brain-bbqs.org/schema#RoleSourceEnum#reporter> <https://brain-bbqs.org/schema#RoleSourceEnum#curator> <https://brain-bbqs.org/schema#RoleSourceEnum#funder_notice> ) ;
    skos:definition "Provenance of a ProjectRole assignment (grant_investigators.role_source; live 2026-09-21)." ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> ;
    linkml:permissible_values <https://brain-bbqs.org/schema#RoleSourceEnum#curator>,
        <https://brain-bbqs.org/schema#RoleSourceEnum#funder_notice>,
        <https://brain-bbqs.org/schema#RoleSourceEnum#reporter> .

bbqs:WorkingGroup a owl:Class ;
    rdfs:label "WorkingGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:dashboard_widgets ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:members ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:dashboard_widgets ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:dashboard_widgets ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:Investigator ;
            owl:onProperty bbqs:members ],
        bbqs:Entity ;
    skos:definition "A BBQS working group. Currently stored as a controlled tag on investigators.working_groups[] + canonical_working_group(); promoted here to a first-class node. Membership is the inverse of Investigator.member_of_group." ;
    skos:exactMatch <http://schema.org/Organization> ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:Species a owl:Class ;
    rdfs:label "Species" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:taxonomy_order ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:common_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:taxonomy_class ],
        [ a owl:Restriction ;
