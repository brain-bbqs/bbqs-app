bbqs:SoftwareTool a owl:Class ;
    rdfs:label "SoftwareTool" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:software_license ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:docs_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty bbqs:repo_url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:repo_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:language ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty bbqs:docs_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:repo_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:docs_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:software_license ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:software_license ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:language ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:language ],
        bbqs:CreativeWork,
        bbqs:Entity ;
    skos:definition "A software package, pipeline, or analysis library released by BBQS." ;
    skos:exactMatch <http://schema.org/SoftwareApplication>,
        bioschema:ComputationalTool ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:Tool a owl:Class ;
    rdfs:label "Tool" ;
    rdfs:subClassOf bbqs:Entity,
        bbqs:Product ;
    skos:definition "A research tool/instrument resource that is neither software nor a catalogued device model (resource_type tool). OPEN: confirm intended boundary vs. Device/SoftwareTool." ;
    skos:exactMatch <http://schema.org/Product> ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:Benchmark a owl:Class ;
    rdfs:label "Benchmark" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom bbqs:Entity ;
            owl:onProperty bbqs:evaluates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:evaluates ],
        bbqs:Dataset ;
    skos:closeMatch OBI:0000070 ;
    skos:definition "An evaluation dataset/task used to score models or algorithms." ;
    skos:exactMatch <http://schema.org/Dataset> ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:Dandiset a owl:Class ;
