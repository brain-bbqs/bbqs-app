bbqs:SourceClass a owl:Class ;
    rdfs:label "SourceClass" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:source_code ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:agent_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:agent_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:grade ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:agent_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty bbqs:grade ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:source_code ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:source_code ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:is_verified ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty bbqs:is_verified ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:grade ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:is_verified ] ;
    skos:definition "A provenance source category (source_classes) graded by reliability — whether the who/what behind a value is human, agent, harvester, RePORTER, etc., and how much it is trusted." ;
    skos:exactMatch skos:Concept ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

