    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:posted_by a owl:ObjectProperty ;
    rdfs:label "posted_by" ;
    rdfs:range bbqs:Investigator ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:repo_url a owl:DatatypeProperty ;
    rdfs:label "repo_url" ;
    rdfs:range xsd:anyURI ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:members a owl:ObjectProperty ;
    rdfs:label "members" ;
    rdfs:range bbqs:Investigator ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:CreativeWork a owl:Class ;
    rdfs:label "CreativeWork" ;
    rdfs:subClassOf bbqs:Thing ;
    skos:exactMatch <http://schema.org/CreativeWork> ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:ProjectRoleEnum a owl:Class ;
    rdfs:label "project_role_enum" ;
    owl:unionOf ( <https://brain-bbqs.org/schema#ProjectRoleEnum#contact_pi> <https://brain-bbqs.org/schema#ProjectRoleEnum#co_pi> <https://brain-bbqs.org/schema#ProjectRoleEnum#mpi> <https://brain-bbqs.org/schema#ProjectRoleEnum#co-investigator> <https://brain-bbqs.org/schema#ProjectRoleEnum#trainee> <https://brain-bbqs.org/schema#ProjectRoleEnum#postdoc> <https://brain-bbqs.org/schema#ProjectRoleEnum#graduate_student> <https://brain-bbqs.org/schema#ProjectRoleEnum#research_staff> ) ;
    skos:definition "Per-project role tokens actually present in grant_investigators.role (live 2026-09-21). Mixes PI roles (contact_pi/co_pi/mpi) with trainee/staff roles. NB: the separator is inconsistent in the data -- co-investigator is hyphenated while co_pi/contact_pi use underscores." ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> ;
    linkml:permissible_values <https://brain-bbqs.org/schema#ProjectRoleEnum#co-investigator>,
        <https://brain-bbqs.org/schema#ProjectRoleEnum#co_pi>,
        <https://brain-bbqs.org/schema#ProjectRoleEnum#contact_pi>,
        <https://brain-bbqs.org/schema#ProjectRoleEnum#graduate_student>,
        <https://brain-bbqs.org/schema#ProjectRoleEnum#mpi>,
        <https://brain-bbqs.org/schema#ProjectRoleEnum#postdoc>,
        <https://brain-bbqs.org/schema#ProjectRoleEnum#research_staff>,
        <https://brain-bbqs.org/schema#ProjectRoleEnum#trainee> .

bbqs:Thing a owl:Class ;
    rdfs:label "Thing" ;
    rdfs:subClassOf [ owl:unionOf ( bbqs:Agent bbqs:AnatomicalSite bbqs:BehavioralConstruct bbqs:CognitiveTask bbqs:CreativeWork bbqs:EventAnchor bbqs:JobPosting bbqs:Product bbqs:ProjectAnchor bbqs:Taxon ) ] ;
    skos:exactMatch <http://schema.org/Thing> ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:Investigator a owl:Class ;
    rdfs:label "Investigator" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:reporter_profile_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:institution ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:scholar_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:orcid ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:WorkingGroup ;
            owl:onProperty bbqs:requested_groups ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:held_project_roles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:requested_groups ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:reporter_profile_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:institution ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:WorkingGroup ;
            owl:onProperty bbqs:member_of_group ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:secondary_emails ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:email ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:email ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty bbqs:orcid ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:secondary_emails ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:member_of_group ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:institution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:scholar_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:scholar_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:consortium_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:orcid ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:research_areas ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:research_areas ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:consortium_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty bbqs:reporter_profile_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty bbqs:skills ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:skills ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty bbqs:email ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty bbqs:consortium_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom bbqs:ProjectRole ;
            owl:onProperty bbqs:held_project_roles ],
        bbqs:Entity,
        bbqs:Person ;
    skos:definition "A consortium member. May be a PI, co-I, trainee, collaborator, or a member who is on NO project (III. Live State — membership is not project-derived). Per-project role lives on the ProjectRole edge, NOT here (issue #283)." ;
    skos:exactMatch <http://schema.org/Person> ;
    skos:inScheme <https://brain-bbqs.org/schema/bbqs> .

bbqs:ResourceTypeEnum a owl:Class ;
    rdfs:label "resource_type_enum" ;
    owl:unionOf ( <https://brain-bbqs.org/schema#ResourceTypeEnum#investigator> <https://brain-bbqs.org/schema#ResourceTypeEnum#organization> <https://brain-bbqs.org/schema#ResourceTypeEnum#grant> <https://brain-bbqs.org/schema#ResourceTypeEnum#publication> <https://brain-bbqs.org/schema#ResourceTypeEnum#software> <https://brain-bbqs.org/schema#ResourceTypeEnum#tool> <https://brain-bbqs.org/schema#ResourceTypeEnum#dataset> <https://brain-bbqs.org/schema#ResourceTypeEnum#protocol> <https://brain-bbqs.org/schema#ResourceTypeEnum#benchmark> <https://brain-bbqs.org/schema#ResourceTypeEnum#ml_model> <https://brain-bbqs.org/schema#ResourceTypeEnum#job> <https://brain-bbqs.org/schema#ResourceTypeEnum#announcement> <https://brain-bbqs.org/schema#ResourceTypeEnum#funding> <https://brain-bbqs.org/schema#ResourceTypeEnum#species> <https://brain-bbqs.org/schema#ResourceTypeEnum#algorithm> <https://brain-bbqs.org/schema#ResourceTypeEnum#device> <https://brain-bbqs.org/schema#ResourceTypeEnum#device_category> <https://brain-bbqs.org/schema#ResourceTypeEnum#device_manufacturer> <https://brain-bbqs.org/schema#ResourceTypeEnum#working_group> <https://brain-bbqs.org/schema#ResourceTypeEnum#event> ) ;
    skos:definition "resources.resource_type. First block = shipped values; second block = PROPOSED additions requiring the enum-extend + resource_id backfill migration." ;
