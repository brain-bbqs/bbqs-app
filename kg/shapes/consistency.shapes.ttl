# BBQS KG consistency shapes — the CONTRADICTION checks, hand-written.
#
# These are the shapes LinkML's gen-shacl cannot produce: cross-field and cross-node SPARQL
# constraints that catch "one part of the graph disagrees with another". The boilerplate node/
# cardinality/datatype/pattern shapes come from `gen-shacl kg/bbqs.linkml.yaml` and live separately;
# this file is only the invariants that require reasoning across triples.
#
# Run:  python kg/validate.py kg/fixtures/contradictions.ttl   # expect NON-conformance (fires)
#       python kg/validate.py kg/fixtures/clean.ttl            # expect conformance
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix bbqs:  <https://brain-bbqs.org/schema#> .

# Shared prefix declaration for the SPARQL constraints below.
bbqs:prefixes
  sh:declare [ sh:prefix "bbqs" ; sh:namespace "https://brain-bbqs.org/schema#"^^xsd:anyURI ] .

# ── Invariant #4 — role tokens are canonical ─────────────────────────────────
# A per-project role may only be one of the canonical tokens (trg_normalize_grant_role enforces this
# in the DB; the graph must not smuggle a free-text role past it).
bbqs:ProjectRoleTokenShape
  a sh:NodeShape ;
  sh:targetClass bbqs:ProjectRole ;
  sh:property [
    sh:path bbqs:project_role ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( "contact_pi" "co_pi" "mpi" "co-investigator" "trainee" "postdoc" "graduate_student" "research_staff" ) ;
    sh:message "ProjectRole.project_role must be a canonical token, not free text (#283)." ;
  ] .

# ── Invariant — ProjectRole.held_by must resolve to a real Investigator ───────
# grant_investigators.investigator_id is investigators.id, but Investigator nodes are minted at
# resources.id — using the wrong key made every held_by dangle. The exporter now resolves it; this
# shape guards the invariant so a regression can't silently reintroduce a dangling role holder.
bbqs:HeldByResolvesShape
  a sh:NodeShape ;
  sh:targetClass bbqs:ProjectRole ;
  sh:property [
    sh:path bbqs:held_by ;
    sh:class bbqs:Investigator ;
    sh:message "ProjectRole.held_by must point at a bbqs:Investigator node (no dangling role holder)." ;
  ] ;
  # #6: one role edge is one person on one project. Two holders or two projects on one edge is two
  # facts collapsed into one node. (The generated SHACL has the same maxCounts but can't fire yet, #422.)
  sh:property [
    sh:path bbqs:held_by ;
    sh:maxCount 1 ;
    sh:message "A ProjectRole has one holder; two held_by values collapse two roles into one (#6)." ;
  ] ;
  sh:property [
    sh:path bbqs:on_project ;
    sh:maxCount 1 ;
    sh:class bbqs:Project ;
    sh:message "A ProjectRole is on exactly one bbqs:Project (#6)." ;
  ] .

# ── Invariant #5 — the two role columns must not be conflated ─────────────────
# investigators.role (consortium_role) is ONE free-text career/consortium label. The per-project
# machine role lives on ProjectRole. A canonical role token appearing in consortium_role means the
# graph is asserting project standing from the wrong source — the exact #283 failure.
bbqs:ConsortiumRoleNotAProjectRoleShape
  a sh:NodeShape ;
  sh:targetClass bbqs:Investigator ;
  sh:sparql [
    sh:message "consortium_role holds a per-project role token; project role belongs on ProjectRole (#283)." ;
    sh:prefixes bbqs:prefixes ;
    sh:select """
      SELECT $this ?value WHERE {
        $this bbqs:consortium_role ?value .
        FILTER(REGEX(?value, '(contact.?pi|co.?pi|principal investigator|multiple.?pi|^mpi$|^pi$)', 'i'))
      }
    """ ;
  ] .

# ── Invariant #9 — mechanism must be consistent with grant_number ─────────────
# mechanism (R61/U01/RF1/…) is DERIVED from grant_number; if it is present it must appear inside the
# grant_number. Catches a stored/parsed mechanism that disagrees with the award it describes.
bbqs:MechanismMatchesGrantNumberShape
  a sh:NodeShape ;
  sh:targetClass bbqs:Project ;
  sh:sparql [
    sh:message "mechanism is not contained in grant_number -- they disagree about the award." ;
    sh:prefixes bbqs:prefixes ;
    sh:select """
      SELECT $this ?mechanism ?grant WHERE {
        $this bbqs:mechanism ?mechanism .
        $this bbqs:grant_number ?grant .
        FILTER(!CONTAINS(UCASE(STR(?grant)), UCASE(STR(?mechanism))))
      }
    """ ;
  ] .

# ── Invariant #7 — study_species must resolve to a Species node ───────────────
# projects.study_species[] is free text ("Mus musculus", "Humans", "All Species"). Each raw claim
# must resolve to a real Species node (by name or common_name); one that does not is a dangling
# reference — the graph asserts a subject that isn't in it.
bbqs:StudiesSpeciesResolvesShape
  a sh:NodeShape ;
  sh:targetClass bbqs:Project ;
  sh:sparql [
    sh:message "study_species does not resolve to a Species node -- dangling reference (#7)." ;
    sh:prefixes bbqs:prefixes ;
    sh:select """
      SELECT $this ?value WHERE {
        $this bbqs:studies_species_name ?value .
        FILTER NOT EXISTS {
          $this bbqs:studies_species ?sp .
          { ?sp bbqs:name ?n } UNION { ?sp bbqs:common_name ?n } UNION { ?sp bbqs:aliases ?n }
          FILTER(LCASE(STR(?n)) = LCASE(STR(?value)))
        }
      }
    """ ;
  ] .

# ── Invariant #12 — no two VERIFIED sources disagree on one field ─────────────
# field_provenance can hold many records for the same (table, column, id). If two of them come from
# verified source classes yet carry different values, the graph literally contradicts itself about a
# single fact. This is the heart of "parts of the graph must not contradict other parts".
bbqs:ConflictingVerifiedProvenanceShape
  a sh:NodeShape ;
  sh:targetClass bbqs:ProvenanceRecord ;
  sh:sparql [
    sh:message "two verified provenance records disagree on the same (table,column,id) field." ;
    sh:prefixes bbqs:prefixes ;
    sh:select """
      SELECT $this ?other WHERE {
        $this  bbqs:prov_entity_table ?t ; bbqs:prov_entity_column ?c ; bbqs:prov_entity_id ?i ;
               bbqs:prov_value_text ?v1 ; bbqs:prov_source_class ?sc1 .
        ?sc1   bbqs:is_verified true .
        ?other bbqs:prov_entity_table ?t ; bbqs:prov_entity_column ?c ; bbqs:prov_entity_id ?i ;
               bbqs:prov_value_text ?v2 ; bbqs:prov_source_class ?sc2 .
        ?sc2   bbqs:is_verified true .
        FILTER(?v1 != ?v2)
        FILTER(STR($this) < STR(?other))
      }
    """ ;
  ] .

# ── Invariant #14 — one ORCID, one Investigator node ──────────────────────────
# An ORCID iD identifies a person, not a row. Two Investigator nodes carrying the same
# bbqs:orcid are the same person recorded twice -- a merge candidate, never two people.
# No targets yet: the anon export doesn't emit `orcid` (full-access export required).
bbqs:OrcidUniquePerPersonShape
  a sh:NodeShape ;
  sh:targetClass bbqs:Investigator ;
  sh:sparql [
    sh:message "Two Investigator nodes share one orcid -- merge candidate, not two people (#14)." ;
    sh:prefixes bbqs:prefixes ;
    sh:select """
      SELECT $this ?other WHERE {
        $this bbqs:orcid ?o .
        ?other bbqs:orcid ?o .
        FILTER(?other != $this)
        FILTER(STR($this) < STR(?other))
      }
    """ ;
  ] .

# ── Invariant #15 — one email (primary or secondary), one Investigator node ───
# investigators.email and investigators.secondary_emails are two slots on ONE row, but the
# same address must not appear as the primary email of one node and the secondary email of
# another -- that's the lyc5332@psu.edu failure: a second identity for a person already known
# by a different address. No targets yet: `email`/`secondary_emails` are PII, restricted from
# the anon export.
bbqs:EmailUniquePerPersonShape
  a sh:NodeShape ;
  sh:targetClass bbqs:Investigator ;
  sh:sparql [
    sh:message "Two Investigator nodes share one email across primary/secondary slots -- merge candidate (#15)." ;
    sh:prefixes bbqs:prefixes ;
    sh:select """
      SELECT $this ?other WHERE {
        { $this bbqs:email ?e } UNION { $this bbqs:secondary_emails ?e } .
        { ?other bbqs:email ?e } UNION { ?other bbqs:secondary_emails ?e } .
        FILTER(?other != $this)
        FILTER(STR($this) < STR(?other))
      }
    """ ;
  ] .

# ── Invariant #16 — one role per person per grant ─────────────────────────────
# A person may hold different roles across different grants (per-edge role is fine), but two
# ProjectRole edges for the SAME held_by + on_project pair asserting different project_role
# values is a contradiction about a single fact: this person's standing on this one grant.
bbqs:OneRolePerPersonPerGrantShape
  a sh:NodeShape ;
  sh:targetClass bbqs:ProjectRole ;
  sh:sparql [
    sh:message "Two ProjectRole edges disagree on the role for the same person on the same grant (#16)." ;
    sh:prefixes bbqs:prefixes ;
    sh:select """
      SELECT $this ?other WHERE {
        $this  bbqs:held_by ?p ; bbqs:on_project ?g ; bbqs:project_role ?r1 .
        ?other bbqs:held_by ?p ; bbqs:on_project ?g ; bbqs:project_role ?r2 .
        FILTER(?other != $this)
        FILTER(?r1 != ?r2)
        FILTER(STR($this) < STR(?other))
      }
    """ ;
  ] .

# ── Invariant #17 — author_orcids resolves to an Investigator node ────────────
# publications.authors is deliberately NOT an FK (free-text byline); author_orcids is where a
# real identity claim can be checked. An ORCID here with no matching bbqs:orcid on any
# Investigator is incomplete identity resolution -- grade it, don't silently drop it (mirrors
# the #7 species-resolution shape). No targets yet: the exporter doesn't emit author_orcids
# for Publication nodes yet.
bbqs:AuthorOrcidResolvesShape
  a sh:NodeShape ;
  sh:targetClass bbqs:Publication ;
  sh:sparql [
    sh:message "author_orcids has an ORCID with no matching Investigator node -- dangling author identity (#17)." ;
    sh:prefixes bbqs:prefixes ;
    sh:select """
      SELECT $this ?orcid WHERE {
        $this bbqs:author_orcids ?orcid .
        FILTER NOT EXISTS { ?inv a bbqs:Investigator ; bbqs:orcid ?orcid }
      }
    """ ;
  ] .

# ── Invariant #18 — a grade-1 claim cannot be overwritten by a grade-3 claim ──
# SourceClass.grade ranks reliability (1 = manual/curator, 3 = harvested). field_provenance is
# append-only (X. Full Data Provenance), so a harvested (grade 3) record disagreeing with an
# existing curated (grade 1) record for the same (table,column,id) is the harvester trying to
# overwrite a human -- flag the curated record, never let the harvested value win silently.
bbqs:GradedProvenancePrecedenceShape
  a sh:NodeShape ;
  sh:targetClass bbqs:ProvenanceRecord ;
  sh:sparql [
    sh:message "a grade-3 (harvested) record disagrees with a grade-1 (curator) record for the same field (#18)." ;
    sh:prefixes bbqs:prefixes ;
    sh:select """
      SELECT $this ?other WHERE {
        $this  bbqs:prov_entity_table ?t ; bbqs:prov_entity_column ?c ; bbqs:prov_entity_id ?i ;
               bbqs:prov_value_text ?v1 ; bbqs:prov_source_class ?sc1 .
        ?sc1   bbqs:grade 1 .
        ?other bbqs:prov_entity_table ?t ; bbqs:prov_entity_column ?c ; bbqs:prov_entity_id ?i ;
               bbqs:prov_value_text ?v2 ; bbqs:prov_source_class ?sc2 .
        ?sc2   bbqs:grade 3 .
        FILTER(?v1 != ?v2)
      }
    """ ;
  ] .

# ── Invariant #19 — a node cannot exist with zero provenance claims ───────────
# Every row came from somewhere; "unknown" is a value, not an absence. Scoped to bbqs:Project
# for now (extend sh:targetClass as other classes get full-access-export coverage). Matches a
# node to its ProvenanceRecords by the shared spine id -- the last path segment of the node's
# IRI vs prov_entity_id. CAUTION: this assumes prov_entity_id is keyed in the SAME id space as
# the node's own resources.id; where a table's provenance rows are keyed by a different table's
# id (the exact investigators.id vs resources.id split behind the held_by bug above), this will
# need the same kind of id-mapping the exporter uses for held_by, not a raw string match.
# GUARD: the FILTER EXISTS keeps #19 dormant when the graph has no ProvenanceRecords at all (the
# anon export -- field_provenance is RLS-hidden). A missing layer is not a node missing its claim;
# without the guard every Project false-fires.
bbqs:NodeHasProvenanceShape
  a sh:NodeShape ;
  sh:targetClass bbqs:Project ;
  sh:sparql [
    sh:message "This node has zero ProvenanceRecord claims (#19)." ;
    sh:prefixes bbqs:prefixes ;
    sh:select """
      SELECT $this WHERE {
        FILTER EXISTS { ?anyprov a bbqs:ProvenanceRecord }
        BIND(STRAFTER(STR($this), "https://brain-bbqs.org/id/") AS ?localId)
        FILTER NOT EXISTS { ?prov a bbqs:ProvenanceRecord ; bbqs:prov_entity_id ?localId }
      }
    """ ;
  ] .

# ── Invariants #1 and #3 — one node, one class ────────────────────────────────
# Every node is exactly one resources.resource_type, and the exporter mints exactly one bbqs: class
# per node (never a superclass as well), so a node carrying two bbqs: classes -- Investigator and
# Project, Person and Organization -- is two things claiming one IRI. For this flat export that
# is the whole of #3's class disjointness; the OWL axioms (owl:disjointWith) add nothing SHACL misses.
bbqs:OneClassPerNodeShape
  a sh:NodeShape ;
  sh:targetSubjectsOf rdf:type ;
  sh:sparql [
    sh:message "This node carries two bbqs: classes; one node is one resource_type (#1, #3)." ;
    sh:prefixes bbqs:prefixes ;
    sh:select """
      SELECT $this ?value WHERE {
        $this a ?a , ?value .
        FILTER(STRSTARTS(STR(?a), "https://brain-bbqs.org/schema#")
            && STRSTARTS(STR(?value), "https://brain-bbqs.org/schema#")
            && STR(?a) < STR(?value))
      }
    """ ;
  ] .

# ── Invariant #1 — a Project came from the grants table ───────────────────────
# Project = Grant: a node typed Project is an NIH award, so it carries its grant_number. One
# without it is a resources row typed `grant` that no grants row backs (e.g. a data standard filed
# as a grant): its type disagrees with the table it came from.
bbqs:ProjectIsAnAwardShape
  a sh:NodeShape ;
  sh:targetClass bbqs:Project ;
  sh:property [
    sh:path bbqs:grant_number ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "A Project is one NIH award: it needs exactly one grant_number; this one has no grants row behind it (#1)." ;
  ] .

# ── Invariant #20 — every award identifier on a Project names the same award ──
# grant_number is the authority. The spine's name, reporter_project_num, nih_link and external_url
# also carry an award number (core form: activity code + IC + serial, e.g. U24DA064429); when one
# names a different award -- a renumbering that updated grants but not resources -- the node says
# two things about which award it is. Values with no award number in them (a title) are skipped.
bbqs:ProjectIdentifiersAgreeShape
  a sh:NodeShape ;
  sh:targetClass bbqs:Project ;
  sh:sparql [
    sh:message "This value names a different award than grant_number (#20)." ;
    sh:prefixes bbqs:prefixes ;
    sh:select """
      SELECT $this ?value WHERE {
        $this bbqs:grant_number ?gn .
        $this ?p ?value .
        FILTER(?p IN (bbqs:name, bbqs:reporter_project_num, bbqs:nih_link, bbqs:external_url))
        FILTER(REGEX(STR(?value), "[A-Z][A-Z0-9]{2}[A-Z]{2}[0-9]{6}"))
        BIND(REPLACE(STR(?gn),    "^.*?([A-Z][A-Z0-9]{2}[A-Z]{2}[0-9]{6}).*$", "$1") AS ?core)
        BIND(REPLACE(STR(?value), "^.*?([A-Z][A-Z0-9]{2}[A-Z]{2}[0-9]{6}).*$", "$1") AS ?vcore)
        FILTER(?vcore != ?core)
      }
    """ ;
  ] .

# ── Invariant #10 (URLs) — a URL-typed field holds a URL ─────────────────────
# These slots are uriorcurie in the schema and xsd:anyURI in the export: one URI (any scheme,
# mailto: included) with no spaces. Two links joined by " ; " or a sentence in place of a link
# contradicts the declared type.
bbqs:UrlFieldsAreUrlsShape
  a sh:NodeShape ;
  sh:targetSubjectsOf bbqs:external_url , bbqs:nih_link , bbqs:website , bbqs:homepage_url ;
  sh:property [ sh:path bbqs:external_url ; sh:pattern "^[A-Za-z][A-Za-z0-9+.-]*:[^ ]+$" ;
                sh:message "external_url is not a single URL (#10)." ] ;
  sh:property [ sh:path bbqs:nih_link ; sh:pattern "^[A-Za-z][A-Za-z0-9+.-]*:[^ ]+$" ;
                sh:message "nih_link is not a single URL (#10)." ] ;
  sh:property [ sh:path bbqs:website ; sh:pattern "^[A-Za-z][A-Za-z0-9+.-]*:[^ ]+$" ;
                sh:message "website is not a single URL (#10)." ] ;
  sh:property [ sh:path bbqs:homepage_url ; sh:pattern "^[A-Za-z][A-Za-z0-9+.-]*:[^ ]+$" ;
                sh:message "homepage_url is not a single URL (#10)." ] .
