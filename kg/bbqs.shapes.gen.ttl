<http://schema.org/Person> a sh:NodeShape ;
    rdfs:comment "A consortium member. May be a PI, co-I, trainee, collaborator, or a member who is on NO project (III. Live State — membership is not project-derived). Per-project role lives on the ProjectRole edge, NOT here (issue #283)." ;
    sh:closed false,
        true ;
    sh:ignoredProperties ( rdf:type ),
        ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Google Scholar id." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path bbqs:scholar_id ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path bbqs:research_areas ],
        [ sh:datatype xsd:string ;
            sh:description "PII — restricted in the public API/graph export." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <http://schema.org/email> ],
        [ sh:description "The rdf:type discriminator, from resources.resource_type." ;
            sh:in ( "investigator" "organization" "grant" "publication" "software" "tool" "dataset" "protocol" "benchmark" "ml_model" "job" "announcement" "funding" "species" "algorithm" "device" "device_category" "device_manufacturer" "working_group" "event" "standard" ) ;
            sh:maxCount 1 ;
            sh:order 16 ;
            sh:path bbqs:resourceType ],
        [ sh:datatype xsd:string ;
            sh:description "investigators.role — ONE free-text label; never a machine token (issue #283)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <http://schema.org/jobTitle> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path <http://schema.org/dateModified> ],
        [ sh:class prov:Association ;
            sh:description "ProjectRole edges this investigator holds, across all projects." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path bbqs:held_project_roles ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path bbqs:skills ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <http://schema.org/affiliation> ],
        [ sh:class <http://schema.org/Organization> ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path <http://schema.org/memberOf> ],
        [ sh:class prov:Agent ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <http://schema.org/email> ],
        [ sh:description "The node IRI — minted from resources.id." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path <http://schema.org/identifier> ],
        [ sh:class prov:Activity ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class <http://schema.org/Organization> ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path bbqs:requested_groups ],
        [ sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path dcterms:source ],
        [ sh:description "ORCID iD (orcid: prefix)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path <http://schema.org/identifier> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path <http://schema.org/description> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path <http://schema.org/dateCreated> ],
        [ sh:datatype xsd:integer ;
            sh:description "NIH RePORTER profile id." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path bbqs:reporter_profile_id ],
        [ sh:description "resources.external_url — canonical off-graph URL." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path <http://schema.org/url> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path <http://schema.org/name> ],
        [ sh:datatype xsd:string ;
            sh:description "resources.metadata JSON overflow — un-promoted fields." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path bbqs:metadata ],
        [ sh:class <http://schema.org/ResearchOrganization> ;
            sh:description "resources.organization_id." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path <http://schema.org/parentOrganization> ] ;
    sh:targetClass <http://schema.org/Person> .

<http://schema.org/ResearchOrganization> a sh:NodeShape ;
    rdfs:comment "A university, institute, or lab participating in BBQS." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path <http://schema.org/dateCreated> ],
        [ sh:datatype xsd:string ;
