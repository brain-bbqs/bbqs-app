<http://schema.org/Event> a sh:NodeShape ;
    rdfs:comment "A BBQS workshop, convening, or meeting. RESERVED: no data table populates this yet — class exists so the exporter/UI have a home when events land." ;
    sh:closed false,
        true ;
    sh:ignoredProperties ( rdf:type ),
        ( rdf:type ) ;
    sh:property [ sh:class <http://schema.org/ResearchOrganization> ;
            sh:description "resources.organization_id." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path <http://schema.org/parentOrganization> ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <http://schema.org/endDate> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <http://schema.org/description> ],
        [ sh:class prov:Agent ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path prov:wasAttributedTo ],
        [ sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path dcterms:source ],
        [ sh:class prov:Activity ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <http://schema.org/name> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path <http://schema.org/dateModified> ],
        [ sh:description "The node IRI — minted from resources.id." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path <http://schema.org/identifier> ],
        [ sh:class <http://schema.org/Person> ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <http://schema.org/attendee> ],
        [ sh:description "The rdf:type discriminator, from resources.resource_type." ;
            sh:in ( "investigator" "organization" "grant" "publication" "software" "tool" "dataset" "protocol" "benchmark" "ml_model" "job" "announcement" "funding" "species" "algorithm" "device" "device_category" "device_manufacturer" "working_group" "event" "standard" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path bbqs:resourceType ],
        [ sh:datatype xsd:string ;
            sh:description "Physical or virtual venue for the workshop/convening." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <http://schema.org/location> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path <http://schema.org/dateCreated> ],
        [ sh:datatype xsd:string ;
            sh:description "resources.metadata JSON overflow — un-promoted fields." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path bbqs:metadata ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <http://schema.org/startDate> ],
        [ sh:description "resources.external_url — canonical off-graph URL." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path <http://schema.org/url> ] ;
    sh:targetClass <http://schema.org/Event> .

<http://schema.org/JobPosting> a sh:NodeShape ;
