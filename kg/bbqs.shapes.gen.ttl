bbqs:MarrModel a sh:NodeShape ;
    rdfs:comment "RESERVED STUB. The BBQS-Marr object: the causal / conceptual-neuroscience graph for a project, spanning Marr's computational, algorithmic, and implementational levels. Developed separately (Nader's causal-KG) and NOT ready — modeled here only as a node Project.has_model can point at, plus the hooks below. Do not flesh out until the causal-KG lands." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:string ;
            sh:description "Marr level 2 — representation & algorithm. RESERVED." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path bbqs:algorithmic_level ],
        [ sh:class <http://schema.org/ResearchOrganization> ;
