@prefix bbqs: <https://brain-bbqs.org/schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:Standard a sh:NodeShape ;
    rdfs:comment "A data or metadata standard (resource_type standard), e.g. Psych-DS for behavioral datasets. Not a BBQS award: an award that funds it is recorded in award_numbers, never as a Project." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <http://schema.org/description> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path <http://schema.org/dateCreated> ],
        [ sh:class <http://schema.org/ResearchOrganization> ;
            sh:description "resources.organization_id." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path <http://schema.org/parentOrganization> ],
        [ sh:description "The rdf:type discriminator, from resources.resource_type." ;
            sh:in ( "investigator" "organization" "grant" "publication" "software" "tool" "dataset" "protocol" "benchmark" "ml_model" "job" "announcement" "funding" "species" "algorithm" "device" "device_category" "device_manufacturer" "working_group" "event" "standard" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path bbqs:resourceType ],
        [ sh:class prov:Activity ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <http://schema.org/name> ],
        [ sh:class prov:Agent ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path prov:wasAttributedTo ],
        [ sh:description "The node IRI — minted from resources.id." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path <http://schema.org/identifier> ],
        [ sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:string ;
            sh:description "Award number(s) behind this resource: a dandiset's grants, a standard's funding award." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path bbqs:award_numbers ],
        [ sh:description "resources.external_url — canonical off-graph URL." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path <http://schema.org/url> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <http://schema.org/softwareVersion> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <http://schema.org/codeRepository> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path <http://schema.org/url> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <http://schema.org/license> ],
        [ sh:datatype xsd:string ;
            sh:description "resources.metadata JSON overflow — un-promoted fields." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path bbqs:metadata ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path <http://schema.org/dateModified> ] ;
    sh:targetClass dcterms:Standard .

<http://schema.org/Article> a sh:NodeShape ;
    rdfs:comment "A consortium news post or announcement. `news`, funding blurbs, etc." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <http://schema.org/description> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <http://schema.org/name> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <http://schema.org/url> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path <http://schema.org/dateModified> ],
        [ sh:datatype xsd:string ;
            sh:description "Display text for `link`, when the announcement points off-site." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path bbqs:link_text ],
        [ sh:description "The node IRI — minted from resources.id." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path <http://schema.org/identifier> ],
        [ sh:description "The rdf:type discriminator, from resources.resource_type." ;
            sh:in ( "investigator" "organization" "grant" "publication" "software" "tool" "dataset" "protocol" "benchmark" "ml_model" "job" "announcement" "funding" "species" "algorithm" "device" "device_category" "device_manufacturer" "working_group" "event" "standard" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path bbqs:resourceType ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path <http://schema.org/dateCreated> ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path bbqs:is_external_link ],
        [ sh:class <http://schema.org/ResearchOrganization> ;
            sh:description "resources.organization_id." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path <http://schema.org/parentOrganization> ],
        [ sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path dcterms:source ],
        [ sh:class <http://schema.org/Person> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path <http://schema.org/author> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <http://schema.org/articleBody> ],
        [ sh:datatype xsd:string ;
            sh:description "resources.metadata JSON overflow — un-promoted fields." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path bbqs:metadata ],
        [ sh:class prov:Activity ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "resources.external_url — canonical off-graph URL." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path <http://schema.org/url> ],
        [ sh:class prov:Agent ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path prov:wasAttributedTo ] ;
    sh:targetClass <http://schema.org/Article> .

<http://schema.org/CreativeWork> a sh:NodeShape ;
    rdfs:comment "A computational algorithm, distinct from its software implementation and from a trained model. Promoted to its own resource_type rather than folded into SoftwareTool/MLModel/Protocol, since it's expected to link directly to Species as its own scope grows.",
        "An NIH (or other) funding call — the \"funding calls\" surface (funding_opportunities: fon/activity_code/due_dates…). resource_type=funding. NB: table needs resource_id backfill to enter the spine.",
        "An experimental/analysis protocol or method (resource_type protocol)." ;
    sh:closed false,
        true ;
    sh:ignoredProperties ( rdf:type ),
        ( rdf:type ),
        ( rdf:type ),
        ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path <http://schema.org/dateModified> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <http://schema.org/description> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <http://schema.org/dateCreated> ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
