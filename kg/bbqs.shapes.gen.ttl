            sh:path <http://schema.org/parentOrganization> ],
        [ sh:description "resources.external_url — canonical off-graph URL." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path <http://schema.org/url> ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text statement of the funding opportunity's purpose." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path bbqs:purpose ],
        [ sh:class <http://schema.org/ResearchOrganization> ;
            sh:description "resources.organization_id." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path <http://schema.org/parentOrganization> ],
